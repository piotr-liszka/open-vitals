# OpenVitals — copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).

# --- Web service (LAN-facing) ---

# Host port the web UI is published on.
WEB_PORT=3000

# Auth is passwordless Google OIDC (spec 012); sessions are DB-backed opaque ids. There is no
# APP_PASSWORD, SESSION_SECRET, or static MCP_TOKEN — the /mcp endpoint is gated by a per-user
# token minted in the app and rotatable from Settings.

# The public origin your users (and their AI clients) reach this service on — used to build the
# OIDC redirect URI and the per-user MCP URL. In production set this to your https domain.
PUBLIC_BASE_URL=http://192.168.1.50:3000

# IANA timezone the app resolves "today" in and renders timestamps with (spec 018). App-scoped,
# not per-user. Defaults to Europe/Warsaw; set it if you are not in Poland.
# APP_TIMEZONE=Europe/Warsaw

# How often the background sync checks Garmin for new data, in minutes (spec 027). Each check is a
# two-call probe that fast-returns when nothing changed, so 30 minutes is cheap. Minimum 5.
# SYNC_INTERVAL_MINUTES=30

# Which Garmin adapter to use: `http` (default, talks to the sidecar) or `mock` (fixture data,
# DEV ONLY — refused when NODE_ENV=production). `make dev` sets this to `mock` automatically.
# GARMIN_ADAPTER=http

# --- Accounts & auth (spec 012 — multi-user, Google OIDC) ---

# Postgres (internal service). Set a strong password; user/db default to garmin/garmin_bridge.
POSTGRES_PASSWORD=change-me-strong-db-password
# POSTGRES_USER=garmin
# POSTGRES_DB=garmin_bridge
# The web service builds DATABASE_URL from the above; override it directly if using external Postgres:
# DATABASE_URL=postgres://garmin:password@db:5432/garmin_bridge

# Google OAuth client (create at https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI must be:  <PUBLIC_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Auth adapter: `oidc` (default, real Google) or `mock` (dev only — signs in a fixed dev user,
# refused when NODE_ENV=production). `make dev` sets this to `mock`.
# AUTH_ADAPTER=oidc

# --- Garmin sidecar (internal only) ---

# Fernet key encrypting the stored Garmin tokens. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-fernet-key

# Shared secret between the web tier and the sidecar (spec 055). The sidecar identifies the user
# from an `X-User-Id` header, which is an ASSERTION — without this key, anything that can reach the
# sidecar's port on the Docker network can name any user and read their Garmin data. Compose passes
# one value to both services. Generate one:
#   openssl rand -base64 32
# Leaving it empty keeps the pre-055 behaviour (guardrail off) and both services warn at startup.
INTERNAL_API_KEY=change-me-internal-shared-secret

# --- Update check (spec 068) ---

# Settings → "Wersja" can ask GitHub whether a newer commit exists than the one this build was made
# from. It only ANSWERS the question — nothing here updates the deployment; that stays manual.
# The repo is private, so the check needs a token to read it. A fine-grained personal access token
# with read-only "Contents" on this one repository is enough:
#   https://github.com/settings/personal-access-tokens
# Leave it empty and the card simply reports "sprawdzanie nieskonfigurowane" — nothing else changes.
# GITHUB_TOKEN=github_pat_...

# Which repo/branch counts as "newest". Defaults below; override only for a fork or a release branch.
# UPDATE_CHECK_REPO=piotr-liszka/garmin-bridge
# UPDATE_CHECK_BRANCH=main

# --- /mcp hardening (spec 055) ---

# Requests per minute per user on /mcp, and rejected tokens per minute per client IP. The second
# bounds brute-force against the per-user MCP token; legitimate clients never consume it.
# MCP_RATE_LIMIT=120
# MCP_AUTH_FAILURE_LIMIT=30

# Whether X-Forwarded-For may be believed when keying that per-IP limiter. Set to `on` ONLY when a
# reverse proxy you control terminates TLS in front of this service — otherwise the header is
# attacker-supplied and lets one client mint unlimited fresh buckets.
# MCP_TRUST_PROXY=off
