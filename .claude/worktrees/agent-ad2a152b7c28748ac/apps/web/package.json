{
  "name": "openvitals-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run build:mcp",
    "build:mcp": "esbuild src/lib/mcp/entry.ts --bundle --platform=node --format=esm --packages=external --outfile=build-mcp/index.js",
    "start": "node server.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm run test && pnpm run check && pnpm run lint && pnpm run build"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  }
}
